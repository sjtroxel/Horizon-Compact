{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeSonnet",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": ${bedrock_resources}
    },
    {
      "Sid": "ResultsObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::${results_bucket}/development/*"
    },
    {
      "Sid": "ResultsList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${results_bucket}",
      "Condition": {
        "StringLike": {
          "s3:prefix": "development/*"
        }
      }
    }
  ]
}
