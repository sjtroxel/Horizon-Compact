{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeSonnet",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": ${bedrock_resources}
    },
    {
      "Sid": "ReadOpenRouterKey",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:${region}:${account_id}:parameter/horizon-compact/openrouter-key"
    },
    {
      "Sid": "DecryptOpenRouterKey",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:${region}:${account_id}:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.${region}.amazonaws.com",
          "kms:EncryptionContext:PARAMETER_ARN": "arn:aws:ssm:${region}:${account_id}:parameter/horizon-compact/openrouter-key"
        }
      }
    },
    {
      "Sid": "ReadAnthropicKey",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:${region}:${account_id}:parameter/horizon-compact/anthropic-key"
    },
    {
      "Sid": "DecryptAnthropicKey",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:${region}:${account_id}:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.${region}.amazonaws.com",
          "kms:EncryptionContext:PARAMETER_ARN": "arn:aws:ssm:${region}:${account_id}:parameter/horizon-compact/anthropic-key"
        }
      }
    },
    {
      "Sid": "ResultsObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::${results_bucket}/development/*",
        "arn:aws:s3:::${results_bucket}/pilot/*",
        "arn:aws:s3:::${results_bucket}/official/*"
      ]
    },
    {
      "Sid": "ResultsList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${results_bucket}",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "development/*",
            "pilot/*",
            "official/*"
          ]
        }
      }
    }
  ]
}
