{
  "permissions": {
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git tag*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(aws *)"
    ],
    "allow": [
      "Bash(make check*)",
      "Bash(make lint*)",
      "Bash(make typecheck*)",
      "Bash(make test*)",
      "Bash(make root-check*)",
      "Bash(make paths-check*)",
      "Bash(make doctor*)",
      "Bash(make guard-history*)",
      "Bash(make fingerprint*)",
      "Bash(uv run --no-sync pytest*)",
      "Bash(uv run --no-sync ruff*)",
      "Bash(uv run --no-sync mypy*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git ls-files*)",
      "Bash(git show*)"
    ]
  }
}
